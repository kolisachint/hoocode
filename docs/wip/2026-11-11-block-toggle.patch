+pub fn gutter_span(focused: bool, palette: &Palette) -> Span<'static> {
+    if !focused {
+        return Span::raw(" ".to_string());
+    }
+    let mut style = palette.acc();
+    if mono() {
+        style = hoocode_tui_ratatui::bold(style);
+    }
