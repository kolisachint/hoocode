diff --git a/.github/workflows/release-tag.yml b/.github/workflows/release-tag.yml
new file mode 100644
index 00000000..acaaa1ef
--- /dev/null
+++ b/.github/workflows/release-tag.yml
@@ -0,0 +1,91 @@
+name: Release from tag
+
+# Pushing a version tag (vX.Y.Z) by hand releases that commit: CI gates (ci.yml)
+# → GitHub release → binaries for 4 targets, SHA256SUMS, npm and PyPI
+# (binaries.yml). The usual path is still a labelled PR (merge-release.yml →
+# release.yml), which bumps the version itself; this one is for a version that
+# was bumped and committed by hand (scripts/bump_versions.py, CONTRIBUTING.md).
+#
+# No double runs:
+# - release.yml pushes its tag with GITHUB_TOKEN, and pushes made with that
+#   token do not start workflows, so its tags never reach this file.
+# - A release created by hand in the GitHub UI is built by binaries.yml's own
+#   `release: published` trigger. If the release for the tag already exists when
+#   this workflow gets to it, it leaves the build to that trigger.
+
+on:
+  push:
+    tags: ["v[0-9]+.[0-9]+.[0-9]+"]
+
+concurrency:
+  group: release-tag-${{ github.ref_name }}
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+
+jobs:
+  check:
+    # Cheap checks first, so a wrong tag fails in seconds, not after the gates.
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Tag matches the workspace version
+        env:
+          TAG: ${{ github.ref_name }}
+        run: |
+          version=$(python3 -c 'import tomllib; print(tomllib.load(open("Cargo.toml", "rb"))["workspace"]["package"]["version"])')
+          if [ "v$version" != "$TAG" ]; then
+            echo "::error::Tag $TAG does not match the workspace version $version in Cargo.toml. Bump it first (scripts/bump_versions.py) and tag that commit."
+            exit 1
+          fi
+      - name: Tagged commit is on main
+        run: |
+          git fetch -q origin main
+          if ! git merge-base --is-ancestor "$GITHUB_SHA" origin/main; then
+            echo "::error::$GITHUB_REF_NAME points at a commit that is not on main. Release from main only."
+            exit 1
+          fi
+
+  gates:
+    needs: check
+    uses: ./.github/workflows/ci.yml
+    permissions:
+      contents: read
+
+  release:
+    needs: gates
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    outputs:
+      build: ${{ steps.create.outputs.build }}
+    steps:
+      - name: GitHub release
+        id: create
+        # Created before the binaries so each target uploads as soon as it is built.
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          TAG: ${{ github.ref_name }}
+        run: |
+          if gh release view "$TAG" >/dev/null 2>&1; then
+            echo "::notice::Release $TAG already exists (made by hand); binaries.yml's release trigger builds it."
+            echo "build=false" >> "$GITHUB_OUTPUT"
+          else
+            gh release create "$TAG" --verify-tag --generate-notes
+            echo "build=true" >> "$GITHUB_OUTPUT"
+          fi
+
+  binaries:
+    needs: release
+    if: needs.release.outputs.build == 'true'
+    uses: ./.github/workflows/binaries.yml
+    with:
+      tag: ${{ github.ref_name }}
+    permissions:
+      contents: write
+      id-token: write
+    secrets: inherit
