# Legitimate literal key names in the TUI crates (scripts/ci/no_literal_keys.py).
# One entry per line: `path | needle | reason`. The needle is text that must
# appear in the source line of the literal; `*` allows the whole file. Each
# entry says why the name is not a hint shown on screen.

# Key tables and parsers: they define key names, so they must write them.
crates/hoocode-tui-keys/src/constants.rs | * | key-name tables and terminal byte sequences
crates/hoocode-tui-keys/src/matching.rs | * | the matcher: key names it recognizes
crates/hoocode-tui-keys/src/parse.rs | * | parser of terminal input into key names
crates/hoocode-tui-keys/src/keybindings.rs | * | the library's default key table and SPACE_KEY, first_key_name
crates/hoocode-tui-keys/src/sequence.rs | * | key sequence parsing (errors name the leader and the steps)
crates/hoocode-tui-keys/src/leader.rs | * | leader key validation
crates/hoocode-code-tui-keybindings/src/keybindings.rs | * | the app's default key table (declaration order is the grouping)
crates/hoocode-code-tui-keybindings/src/config.rs | * | keybindings.json parser: reserved and warned key lists, messages that name the default leader
crates/hoocode-code-tui-keybindings/src/hints.rs | "escape" => "esc" | display name of the escape key, the one mapping
crates/hoocode-code-tui-widgets/src/controls.rs | part.eq_ignore_ascii_case("escape") | lit_key: key-name formatter for the /hotkeys pane
crates/hoocode-code-tui-widgets/src/controls.rs | "esc".to_string() | lit_key: key-name formatter for the /hotkeys pane
crates/hoocode-tui-components/src/markdown/lexer.rs | Self::Space => "space" | markdown token name, not a key hint
crates/hoocode-tui-components/src/markdown/lexer.rs | Self::Escape => "escape" | markdown token name, not a key hint

# Key matching in the code path: the key is read, not shown.
crates/hoocode-tui-components/src/editor/editor.rs | matches_key( | key handling (raw input match), not a hint
crates/hoocode-tui-components/src/editor/editor.rs | k == "shift+enter" | key handling: the kitty and legacy names of a key
crates/hoocode-code-tui-selectors/src/config_selector.rs | matches_key(data, "ctrl+c") | key handling: Ctrl+C exits, not a hint
crates/hoocode-code-tui-selectors/src/scoped_models_selector.rs | matches_key(data, "f1") | key handling: f1 opens help beside the keymap help key
crates/hoocode-code-tui-selectors/src/scoped_models_selector.rs | matches_key(data, "ctrl+c") | key handling: Ctrl+C exits, not a hint
crates/hoocode-code-tui-selectors/src/scoped_models_selector.rs | matches_key(data, "escape") | key handling: escape cancels, not a hint
crates/hoocode-code-tui-selectors/src/session_selector.rs | matches_key(data, "f1") | key handling: f1 opens help beside the keymap help key
crates/hoocode-code-tui-selectors/src/tree_selector.rs | matches_key(data, "f1") | key handling: f1 opens help beside the keymap help key

# A word, not a key name.
crates/hoocode-code-tui-widgets/src/task_panel.rs | "tab", | the action label of the ←→ pair (switch tabs), not a key name
