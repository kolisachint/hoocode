{
  "description": "Scoped models effort and category: /scoped-models enables a reasoning model, tab cycles its effort, alt+j cycles its category, alt+s saves to settings, and reopening /scoped-models shows the saved effort and category.",
  "phase": "11.3b",
  "terminal": {
    "cols": 100,
    "rows": 40
  },
  "settings": {
    "enableSemanticIndex": false
  },
  "models": [
    {"id": "mock-model", "name": "Mock Model", "contextWindow": 128000, "maxTokens": 4096, "reasoning": true},
    {"id": "mock-fast", "name": "Mock Fast", "contextWindow": 64000, "maxTokens": 4096},
    {"id": "mock-large", "name": "Mock Large", "contextWindow": 200000, "maxTokens": 8192}
  ],
  "args": [
    "--offline",
    "--light",
    "--provider",
    "mock",
    "--model",
    "mock-model",
    "--no-session"
  ],
  "llm": [],
  "steps": [
    {"wait_for": "❯", "timeout": 30},
    {"wait_stable": 1.0, "timeout": 20},
    {"type": "/scoped-models"},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Enter"]},
    {"wait_for": "Session-only", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Enter"]},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Tab"]},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Tab"]},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["M-j"]},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "edited", "contains": ["1/3 enabled", "(unsaved)", "cheap"]},
    {"keys": ["M-s"]},
    {"wait_for": "Model selection saved", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "saved", "contains": ["Model selection saved", "cheap"], "not_contains": ["(unsaved)"]},
    {"keys": ["Escape"]},
    {"wait_gone": "Session-only", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"type": "/scoped-models"},
    {"wait_stable": 1.0, "timeout": 20},
    {"keys": ["Enter"]},
    {"wait_for": "Session-only", "timeout": 20},
    {"wait_stable": 1.0, "timeout": 20},
    {"snapshot": "reopened", "contains": ["1/3 enabled", "cheap"], "not_contains": ["(unsaved)"]}
  ]
}
