{
  "description": "--resume: a first -p run leaves a session; `--resume` opens the session picker before startup (header, hints, the session row), Enter resumes it, the transcript shows the earlier exchange, and a new prompt carries it to the model.",
  "phase": "11.3a1",
  "compare_requests": true,
  "request_fields": [
    "messages"
  ],
  "terminal": {
    "cols": 100,
    "rows": 30
  },
  "settings": {
    "enableSemanticIndex": false
  },
  "pre_runs": [
    [
      "--offline",
      "--light",
      "--provider",
      "mock",
      "--model",
      "mock-model",
      "-p",
      "remember the word apple"
    ]
  ],
  "args": [
    "--offline",
    "--light",
    "--provider",
    "mock",
    "--model",
    "mock-model",
    "--resume"
  ],
  "llm": [
    {
      "text": "Noted: apple."
    },
    {
      "text": "The word was apple."
    }
  ],
  "steps": [
    {
      "wait_for": "Sessions  /resume",
      "timeout": 30
    },
    {
      "wait_stable": 1.0,
      "timeout": 20
    },
    {
      "snapshot": "picker",
      "contains": [
        "Sessions  /resume",
        "this folder",
        "remember the word apple"
      ]
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "wait_for": "Noted: apple",
      "timeout": 30
    },
    {
      "wait_stable": 1.0,
      "timeout": 20
    },
    {
      "snapshot": "resumed",
      "contains": [
        "remember the word apple",
        "Noted: apple."
      ]
    },
    {
      "type": "what was the word?"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "wait_for": "The word was apple",
      "timeout": 30
    },
    {
      "wait_stable": 1.0,
      "timeout": 20
    },
    {
      "snapshot": "answered",
      "contains": [
        "The word was apple."
      ]
    }
  ],
  "normalize": [
    {
      "_why": "the session slug (detail column, status line) is derived from the random session id",
      "pattern": "[a-z]+-[a-z]+(?= · (mock-model|\\d+ messages))",
      "replace": "<slug>"
    },
    {
      "_why": "the gap before the message count moves with the random session name's length (the slug rule above keeps the length); the count sits two columns after the model",
      "pattern": " {2,}(· \\d+ messages)",
      "replace": "  \\1"
    }
  ]
}
