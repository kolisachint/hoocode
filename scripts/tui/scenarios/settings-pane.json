{
  "description": "/settings: the pane opens over the prompt with its categories; Enter opens a category; turning bash off applies live (tool count and per-turn surface re-priced); Escape backs out to the pane and then to the prompt. The pane snapshots are masked: the Rust build has no external-tools layer (reliability 1.4), so its pane has no External tools row, no needs-binary markers and no gate notes, and its label column is narrower. Their contains assertions still run for both apps, and the closed snapshot is compared.",
  "phase": "11.3d2",
  "mask_snapshots": ["pane", "category", "toggled", "back"],
  "terminal": {
    "cols": 100,
    "rows": 40
  },
  "settings": {
    "enableSemanticIndex": false
  },
  "args": [
    "--offline",
    "--light",
    "--provider",
    "mock",
    "--model",
    "mock-model",
    "--no-session"
  ],
  "llm": [],
  "steps": [
    {
      "wait_for": "❯",
      "timeout": 30
    },
    {
      "wait_stable": 1.0,
      "timeout": 20
    },
    {
      "type": "/settings"
    },
    {
      "wait_stable": 1.0,
      "timeout": 20
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "wait_stable": 1.5,
      "timeout": 20
    },
    {
      "snapshot": "pane"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "wait_stable": 1.5,
      "timeout": 20
    },
    {
      "snapshot": "category",
      "contains_line": [
        [
          "Shell",
          "on"
        ]
      ]
    },
    {
      "keys": [
        "Down",
        "Down"
      ]
    },
    {
      "wait_stable": 1.0,
      "timeout": 20
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "wait_stable": 1.5,
      "timeout": 20
    },
    {
      "snapshot": "toggled",
      "contains_line": [
        [
          "Shell",
          "off"
        ]
      ]
    },
    {
      "keys": [
        "Escape"
      ]
    },
    {
      "wait_stable": 1.5,
      "timeout": 20
    },
    {
      "snapshot": "back"
    },
    {
      "keys": [
        "Escape"
      ]
    },
    {
      "wait_stable": 1.5,
      "timeout": 20
    },
    {
      "snapshot": "closed"
    }
  ]
}
